{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WinIsle",
  "version": "1.1.0",
  "identifier": "com.isle.dynamicisland",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WinIsle",
        "width": 740,
        "height": 340,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "center": false,
        "x": 0,
        "y": 0,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --enable-low-end-device-mode --force-gpu-mem-available-mb=16 --gpu-program-cache-size-kb=256 --disable-gpu-shader-disk-cache --disable-gpu-memory-buffer-video-frames --renderer-process-limit=1 --process-per-site --disable-site-isolation-trials --no-zygote --disable-breakpad --disable-crash-reporter --disable-background-networking --disable-component-update --disable-domain-reliability --disable-sync --disable-spell-checking --disk-cache-size=524288 --media-cache-size=524288 --enable-features=MemoryReducer --disable-features=SpareRendererForSitePerProcess,BackForwardCache,Translate,OptimizationHints,MediaRouter,CalculateNativeWinOcclusion,AutofillServerCommunication,InterestFeedContentSuggestions,Prerender2,SpeculativeServiceWorkerWarmUp,AudioServiceOutOfProcess --js-flags=--max-old-space-size=24"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
