{
  "name": "isle",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Standalone frameless Dynamic Island overlay for Windows with synced lyrics, calls, focus timer, reminders, shelf, calendar, alerts, and voice assistant.",
  "author": "Isle Desktop",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "build:server": "node scripts/generate-tray-icon.mjs && node scripts/build-server.mjs",
    "tauri:dev": "node scripts/generate-tray-icon.mjs && npx @tauri-apps/cli@2 dev",
    "tauri:build": "node scripts/generate-tray-icon.mjs && npm run build && npx @tauri-apps/cli@2 build --bundles nsis && node scripts/package-release-zip.mjs",
    "electron:dev": "npm run build && npm run build:server && electron .",
    "electron:build": "npm run build && npm run build:server && electron-builder --win nsis --x64 --publish never && node scripts/package-release-zip.mjs",
    "build:exe": "npm run tauri:build",
    "dist": "npm run tauri:build",
    "start": "node server.ts",
    "lint": "tsc --noEmit"
  },
  "build": {
    "appId": "com.isle.dynamicisland",
    "productName": "WinIsle",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/assets/aistudio/**/*",
      "dist-server/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "dist-server/**/*",
      "electron/**/*"
    ],
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "WinIsleSetup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WinIsle",
      "runAfterFinish": true,
      "include": "electron/installer.nsh",
      "artifactName": "WinIsleSetup.${ext}"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^35.1.2",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "eslint": "10.12.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@types/ws": "^8.18.2",
    "express": "^5.3.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0"
  }
}
